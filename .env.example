# Port for the web server
PORT=3000

# Secret key for signing user session JWT cookies
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# Public URL of the deployed application (on Render: https://your-service-name.onrender.com)
APP_URL=http://localhost:3000

# Google OAuth 2.0 Credentials (from Google Cloud Console)
# Redirect URI should be: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional: PostgreSQL Database URL (Leave empty to use built-in SQLite)
# If using Render Free Postgres: postgres://user:password@hostname:5432/dbname
DATABASE_URL=
